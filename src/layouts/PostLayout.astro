---
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Prose from '../components/Prose.astro';
import PrevNext from '../components/PrevNext.astro';
import Lightbox from '../components/Lightbox.astro';
import { icons } from '../lib/icons';
import { TYPE_META, isoDate, type Entry } from '../lib/entries';
import { formatLocalizedDate, homeUrl, MESSAGES, type Locale, typeLabel } from '../lib/i18n';

interface Props {
  entry: Entry;
  headings: MarkdownHeading[];
  language: Locale;
  englishUrl: string;
  chineseUrl: string;
  prev?: Entry;
  next?: Entry;
}

const { entry, headings, language, englishUrl, chineseUrl, prev, next } = Astro.props;
const { title, type, tags, date, summary, cover, coverAlt } = entry.data;
const meta = TYPE_META[type];
const copy = MESSAGES[language];

// Headings in the guide carry their own numbers ("1. Install Python"); the TOC draws the number in a circle.
const toc = headings
  .filter((h) => h.depth === 2)
  .map((h, i) => ({ slug: h.slug, n: i + 1, label: h.text.replace(/^\s*\d+[.)]\s*/, '') }));
const tocLabel = type === 'Guide' ? copy.inThisGuide : copy.onThisPage;
---

<BaseLayout
  title={`${title} · Simon Shen`}
  description={summary}
  language={language}
  englishUrl={englishUrl}
  chineseUrl={chineseUrl}
>
  <section class:list={['hero', { 'no-cover': !cover }]} style={`--type-main:${meta.main};--type-tint:${meta.tint}`}>
    <div class="container hero-inner">
      <a href={homeUrl(language)} class="ds-textlink md grey back">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={icons.arrowBack}></path></svg>
        {copy.allEntries}
      </a>
      <header class="head">
        <p class="eyebrow">
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={meta.icon}></path></svg>
          {typeLabel(type, language)}
          <span class="sep" aria-hidden="true">·</span>
          <time datetime={isoDate(date)}>{formatLocalizedDate(date, language)}</time>
        </p>
        <h1>{title}</h1>
        <p class="lead">{summary}</p>
        <ul class="tags" aria-label={copy.tags}>
          {tags.map((t) => <li class="ds-chip sm">#{t}</li>)}
        </ul>
      </header>
    </div>
  </section>

  <main class="container post" style={`--type-tint:${meta.tint}`}>
    {
      cover && (
        <div class="cover">
          <Image
            src={cover}
            alt={coverAlt ?? ''}
            widths={[480, 960, 1440, 1920]}
            sizes="(min-width: 1040px) 960px, calc(100vw - 40px)"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )
    }
    <div class="article">
      {
        toc.length > 1 && (
          <nav class="toc" aria-label={tocLabel}>
            <p class="toc-label">{tocLabel}</p>
            <ol>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>
                    <span class="toc-n" aria-hidden="true">
                      {h.n}
                    </span>
                    {h.label}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <Prose>
        <slot />
      </Prose>
    </div>
    <PrevNext language={language} prev={prev} next={next} />
  </main>
  <Lightbox />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    background: var(--type-tint);
  }
  .hero-inner {
    padding-top: 16px;
    padding-bottom: 80px;
  }
  .hero.no-cover .hero-inner {
    padding-bottom: 24px;
  }
  .ds-textlink.md.grey.back {
    gap: 6px;
    min-height: 44px;
  }
  .head {
    max-width: 800px;
    margin: 20px auto 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    text-align: left;
  }
  .eyebrow {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-condensed);
    font-size: 14px;
    line-height: 16px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .eyebrow svg {
    color: var(--type-main);
  }
  .sep {
    color: var(--site-text-3);
  }
  .eyebrow time {
    font-family: var(--font-sans);
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: var(--site-text-2);
  }
  h1 {
    margin: 0;
    font-family: var(--font-condensed);
    font-size: 28px;
    line-height: 34px;
    font-weight: 700;
    text-wrap: balance;
  }
  .lead {
    margin: 0;
    max-width: 640px;
    font-size: 18px;
    line-height: 27px;
    color: var(--site-text-2);
    text-wrap: pretty;
  }
  .tags {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: flex-start;
  }
  .tags .ds-chip {
    background: var(--site-surface);
  }

  /* ---------- Body ---------- */
  .post {
    padding-bottom: 56px;
  }
  .cover {
    max-width: 960px;
    margin: -56px auto 0;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--elevation-8);
    background: var(--site-subtle);
  }
  .cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .article {
    max-width: 680px;
    margin: 32px auto 0;
  }

  /* ---------- TOC ---------- */
  .toc {
    margin: 0 0 40px;
    padding: 16px 16px 8px;
    border: 1px solid var(--site-border);
    border-radius: var(--radius-xl);
  }
  .toc-label {
    margin: 0 0 10px;
    font-family: var(--font-condensed);
    font-size: 13px;
    line-height: 16px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--site-text-3);
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0 24px;
  }
  .toc a {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-size: 15px;
    line-height: 20px;
    color: var(--site-text);
    text-decoration: none;
  }
  .toc a:hover {
    color: var(--site-link);
  }
  .toc-n {
    flex: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--type-tint);
    font-size: 12px;
    line-height: 24px;
    font-weight: 600;
    text-align: center;
  }

  @media (min-width: 600px) {
    .hero-inner {
      padding-top: 24px;
      padding-bottom: 120px;
    }
    .hero.no-cover .hero-inner {
      padding-bottom: 32px;
    }
    .ds-textlink.md.grey.back {
      min-height: 0;
    }
    .head {
      margin-top: 32px;
      align-items: center;
      text-align: center;
    }
    h1 {
      font-size: 36px;
      line-height: 44px;
    }
    .lead {
      font-size: 20px;
      line-height: 30px;
    }
    .tags {
      justify-content: center;
    }
    .post {
      padding-bottom: 72px;
    }
    .cover {
      margin-top: -88px;
      aspect-ratio: 16 / 8;
      border-radius: var(--radius-xxl);
    }
    .article {
      margin-top: 40px;
    }
    .toc {
      padding: 20px 24px;
    }
    .toc ol {
      grid-template-columns: 1fr 1fr;
    }
    .toc a {
      min-height: 32px;
    }
  }
  @media (min-width: 1024px) {
    .hero-inner {
      padding-top: 28px;
      padding-bottom: 148px;
    }
    .hero.no-cover .hero-inner {
      padding-bottom: 40px;
    }
    .head {
      margin-top: 40px;
    }
    .post {
      padding-bottom: 80px;
    }
    .cover {
      margin-top: -108px;
    }
    .article {
      margin-top: 48px;
    }
  }
</style>

<script>
  // Smooth-scroll TOC links to their heading (scroll-margin-top supplies the 24px offset).
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLAnchorElement>('.toc a').forEach((link) =>
    link.addEventListener('click', (e) => {
      const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: reduceMotion.matches ? 'auto' : 'smooth', block: 'start' });
      target.setAttribute('tabindex', '-1');
      target.focus({ preventScroll: true });
      history.replaceState(null, '', link.hash);
    }),
  );
</script>
