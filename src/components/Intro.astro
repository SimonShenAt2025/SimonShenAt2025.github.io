---
import { MESSAGES, type Locale } from '../lib/i18n';

interface Props {
  language: Locale;
}

const { language } = Astro.props;
const copy = MESSAGES[language];
---

<section class="intro" aria-labelledby="intro-title">
  <div class="container inner">
    <h1 id="intro-title">{copy.introTitle}</h1>
    <p>{copy.introLead}</p>
    <a class="feedback" href="mailto:shentiexiong@gmail.com">{copy.contactFeedback}: shentiexiong@gmail.com</a>
  </div>
</section>

<style>
  .intro {
    background: var(--site-inverse);
    color: var(--site-on-inverse);
  }
  .inner {
    padding-top: 32px;
    padding-bottom: 40px;
  }
  h1 {
    margin: 0 0 16px;
    max-width: 780px;
    font-family: var(--font-condensed);
    font-size: 28px;
    line-height: 34px;
    font-weight: 700;
    text-wrap: balance;
  }
  p {
    margin: 0;
    max-width: 640px;
    font-size: 17px;
    line-height: 26px;
    color: var(--site-on-inverse-2);
    text-wrap: pretty;
  }
  .feedback {
    display: inline-flex;
    margin-top: 16px;
    color: var(--site-on-inverse);
    font-size: 15px;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .feedback:hover {
    color: var(--site-on-inverse-2);
  }
  @media (min-width: 600px) {
    .inner {
      padding-top: 40px;
      padding-bottom: 56px;
    }
    h1 {
      font-size: 36px;
      line-height: 44px;
    }
    p {
      font-size: 18px;
      line-height: 28px;
    }
  }
  @media (min-width: 1024px) {
    .inner {
      padding-top: 48px;
      padding-bottom: 64px;
    }
  }
</style>
