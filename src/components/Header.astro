---
import { icons } from '../lib/icons';
import { homeUrl, MESSAGES, type Locale } from '../lib/i18n';

interface Props {
  language: Locale;
  englishUrl: string;
  chineseUrl: string;
}

const { language, englishUrl, chineseUrl } = Astro.props;
const copy = MESSAGES[language];
const langs = [
  { code: 'en' as const, label: 'EN', href: englishUrl },
  { code: 'zh' as const, label: '中文', href: chineseUrl },
];
---

<header class="site-header">
  <div class="container row">
    <a class="wordmark" href={homeUrl(language)}>Simon Shen</a>
    <div class="actions">
      <nav class="ds-togglegroup xs rounded color-secondary lang" aria-label={copy.language}>
        {
          langs.map((l) => (
            <a
              class:list={['ds-togglebtn', { selected: l.code === language }]}
              href={l.href || undefined}
              lang={l.code}
              aria-current={l.code === language ? 'page' : undefined}
              aria-disabled={!l.href ? 'true' : undefined}
              tabindex={l.href ? 0 : -1}
            >
              {l.label}
            </a>
          ))
        }
      </nav>
      <button
        type="button"
        class="theme-toggle"
        aria-label={copy.switchToDark}
        title={copy.switchToDark}
        aria-pressed="false"
        data-switch-to-dark={MESSAGES[language].switchToDark}
        data-switch-to-light={MESSAGES[language].switchToLight}
      >
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
          <path class="icon-moon" fill="currentColor" d={icons.darkMode}></path>
          <path class="icon-sun" fill="currentColor" d={icons.lightMode}></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: var(--site-inverse);
  }
  .row {
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .wordmark {
    font-family: var(--font-condensed);
    font-size: 20px;
    line-height: 24px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--site-on-inverse);
    text-decoration: none;
  }
  .wordmark:hover {
    color: var(--site-on-inverse);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  /* Mobile uses the `sm` size; tablet and desktop use `xs`. */
  .ds-togglegroup.xs.lang .ds-togglebtn {
    height: 28px;
    font-size: 14px;
    padding: 0 14px;
    text-decoration: none;
  }
  .theme-toggle {
    flex: none;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid rgb(var(--color-common-white-rgb) / 30%);
    border-radius: 50%;
    background: transparent;
    color: var(--site-on-inverse);
    cursor: pointer;
  }
  .theme-toggle:hover {
    background: rgb(var(--color-common-white-rgb) / 12%);
  }
  /* Moon in light mode, sun in dark mode. */
  .icon-sun,
  :global([data-theme='dark']) .icon-moon {
    display: none;
  }
  :global([data-theme='dark']) .icon-sun {
    display: inline;
  }
  @media (min-width: 600px) {
    .row {
      height: 64px;
    }
    .ds-togglegroup.xs.lang .ds-togglebtn {
      height: 24px;
      font-size: 13px;
      padding: 0 12px;
    }
    .theme-toggle {
      width: 36px;
      height: 36px;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle')!;

  function syncThemeButton() {
    const isDark = root.dataset.theme === 'dark';
    const label = isDark ? toggle.dataset.switchToLight! : toggle.dataset.switchToDark!;
    toggle.setAttribute('aria-label', label);
    toggle.title = label;
    toggle.setAttribute('aria-pressed', String(isDark));
  }

  toggle.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('ss-theme', next);
    } catch {}
    syncThemeButton();
  });
  syncThemeButton();
</script>
