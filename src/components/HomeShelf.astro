---
import EntryCard from './EntryCard.astro';
import FilterBar from './FilterBar.astro';
import Intro from './Intro.astro';
import { MESSAGES, type Locale } from '../lib/i18n';
import type { Entry } from '../lib/entries';

interface Props {
  entries: Entry[];
  language: Locale;
}

const { entries, language } = Astro.props;
const copy = MESSAGES[language];
---

<Intro language={language} />
<main class="container home">
  <FilterBar entries={entries} language={language} />
  <div class="grid">
    {entries.map((entry, i) => <EntryCard entry={entry} language={language} featured={i === 0} />)}
  </div>
  <div class="empty" hidden>
    <p class="empty-title">{copy.noEntries}</p>
    <p class="empty-text">{copy.tryDifferent}</p>
    <button type="button" class="btn btn-outlined btn-sm btn-rounded" data-clear>{copy.clearFilters}</button>
  </div>
</main>

<style>
  .home {
    padding-top: 24px;
    padding-bottom: 56px;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-auto-flow: dense;
    gap: 16px;
  }
  .empty {
    padding: 64px 0;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .empty-title {
    margin: 0;
    font-size: 18px;
    line-height: 24px;
    font-weight: 500;
  }
  .empty-text {
    margin: 0 0 8px;
    font-size: 14px;
    line-height: 20px;
    color: var(--site-text-2);
  }
  @media (min-width: 600px) {
    .home {
      padding-top: 28px;
      padding-bottom: 72px;
    }
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
  }
  @media (min-width: 1024px) {
    .home {
      padding-top: 32px;
      padding-bottom: 80px;
    }
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>

<script>
  const typeButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-type].ds-togglebtn')];
  const tagButtons = [...document.querySelectorAll<HTMLButtonElement>('.tag-btn')];
  const search = document.querySelector<HTMLInputElement>('.filters input[type="search"]')!;
  const clearInline = document.querySelector<HTMLButtonElement>('.filters [data-clear]')!;
  const count = document.querySelector<HTMLElement>('.filters .count')!;
  const cards = [...document.querySelectorAll<HTMLAnchorElement>('.grid .card')];
  const empty = document.querySelector<HTMLElement>('.empty')!;
  const language = document.documentElement.lang;

  const knownTypes = new Set(typeButtons.map((button) => button.dataset.type!));
  const knownTags = new Set(tagButtons.map((button) => button.dataset.tag!));

  const state = { type: 'All', tags: [] as string[], q: '' };

  function readUrl() {
    const params = new URLSearchParams(location.search);
    const type = params.get('type');
    state.type = type && knownTypes.has(type) ? type : 'All';
    state.tags = (params.get('tag') ?? '').split(',').filter((tag) => knownTags.has(tag));
    state.q = params.get('q') ?? '';
    search.value = state.q;
  }

  function writeUrl() {
    const params = new URLSearchParams();
    if (state.type !== 'All') params.set('type', state.type);
    if (state.tags.length) params.set('tag', state.tags.join(','));
    if (state.q.trim()) params.set('q', state.q.trim());
    const query = params.toString().replace(/%2C/g, ',');
    history.replaceState(null, '', query ? `?${query}` : location.pathname);
  }

  function render() {
    const query = state.q.trim().toLowerCase();
    let shown = 0;
    for (const card of cards) {
      const tags = card.dataset.tags!.split('|');
      const matches =
        (state.type === 'All' || card.dataset.type === state.type) &&
        (!state.tags.length || state.tags.some((tag) => tags.includes(tag))) &&
        (!query || card.dataset.title!.includes(query));
      card.hidden = !matches;
      card.classList.toggle('is-featured', matches && shown === 0);
      if (matches) shown++;
    }

    for (const button of typeButtons) {
      const selected = button.dataset.type === state.type;
      button.classList.toggle('selected', selected);
      button.setAttribute('aria-pressed', String(selected));
    }
    for (const button of tagButtons) {
      const selected = state.tags.includes(button.dataset.tag!);
      button.setAttribute('aria-pressed', String(selected));
      button.firstElementChild!.classList.toggle('secondary', selected);
    }

    const hasFilters = state.type !== 'All' || state.tags.length > 0 || query.length > 0;
    clearInline.hidden = !hasFilters;
    count.textContent = language === 'zh' ? `${shown} 篇条目` : `${shown} ${shown === 1 ? 'entry' : 'entries'}`;
    empty.hidden = shown > 0;
  }

  function update() {
    render();
    writeUrl();
  }

  typeButtons.forEach((button) =>
    button.addEventListener('click', () => {
      state.type = button.dataset.type!;
      update();
    }),
  );
  tagButtons.forEach((button) =>
    button.addEventListener('click', () => {
      const tag = button.dataset.tag!;
      state.tags = state.tags.includes(tag) ? state.tags.filter((value) => value !== tag) : [...state.tags, tag];
      update();
    }),
  );
  search.addEventListener('input', () => {
    state.q = search.value;
    update();
  });
  document.querySelectorAll<HTMLButtonElement>('[data-clear]').forEach((button) =>
    button.addEventListener('click', () => {
      state.type = 'All';
      state.tags = [];
      state.q = '';
      search.value = '';
      update();
    }),
  );

  readUrl();
  render();
</script>