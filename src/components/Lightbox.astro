---
import { icons } from '../lib/icons';
---

<div class="lightbox" role="dialog" aria-modal="true" aria-label="Enlarged screenshot" hidden>
  <button type="button" class="close" aria-label="Close enlarged screenshot">
    <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={icons.close}></path></svg>
  </button>
  <img class="image" alt="" />
  <p class="caption"></p>
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 56px;
    background: rgb(var(--color-grey-900-rgb) / 90%);
    font-family: var(--font-sans);
  }
  .close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: var(--site-surface);
    color: var(--site-text);
    cursor: pointer;
  }
  .image {
    display: block;
    width: auto;
    max-width: min(1100px, 100%);
    max-height: calc(100% - 40px);
    min-height: 0;
    object-fit: contain;
    border-radius: var(--radius-md);
  }
  .caption {
    margin: 0;
    max-width: 1100px;
    font-size: 16px;
    line-height: 24px;
    color: var(--color-common-white);
  }
  .caption:empty {
    display: none;
  }
  @media (max-width: 599.98px) {
    .lightbox {
      padding: 72px 20px 56px;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLElement>('.lightbox')!;
  const closeBtn = dialog.querySelector<HTMLButtonElement>('.close')!;
  const image = dialog.querySelector<HTMLImageElement>('.image')!;
  const caption = dialog.querySelector<HTMLElement>('.caption')!;
  let trigger: HTMLButtonElement | null = null;

  function open(btn: HTMLButtonElement) {
    const source = btn.querySelector('img');
    if (!source) return;
    trigger = btn;
    image.src = source.currentSrc || source.src;
    image.alt = source.alt;
    dialog.setAttribute('aria-label', source.alt || 'Enlarged screenshot');
    caption.textContent = btn.closest('figure')?.querySelector('figcaption')?.textContent ?? '';
    dialog.hidden = false;
    document.documentElement.style.overflow = 'hidden';
    closeBtn.focus();
  }

  function close() {
    if (dialog.hidden) return;
    dialog.hidden = true;
    document.documentElement.style.overflow = '';
    image.removeAttribute('src');
    trigger?.focus();
    trigger = null;
  }

  document.querySelectorAll<HTMLButtonElement>('.prose .figure-zoom').forEach((btn) => btn.addEventListener('click', () => open(btn)));
  closeBtn.addEventListener('click', close);
  dialog.addEventListener('click', (e) => {
    if (e.target !== image) close();
  });
  document.addEventListener('keydown', (e) => {
    if (dialog.hidden) return;
    if (e.key === 'Escape') close();
    // The close button is the only control, so keep focus on it.
    if (e.key === 'Tab') {
      e.preventDefault();
      closeBtn.focus();
    }
  });
</script>
