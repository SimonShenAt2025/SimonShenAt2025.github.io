---
import { Image } from 'astro:assets';
import { TYPE_META, entryUrl, isoDate, type Entry } from '../lib/entries';
import { formatLocalizedDate, typeLabel, type Locale } from '../lib/i18n';

interface Props {
  entry: Entry;
  language: Locale;
  /** The first card of the current result set spans two columns on tablet and desktop. */
  featured?: boolean;
}

const { entry, language, featured = false } = Astro.props;
const { title, type, tags, date, summary, cover, coverAlt, status } = entry.data;
const meta = TYPE_META[type];
---

<a
  href={entryUrl(entry)}
  class:list={['card', cover ? 'has-cover' : 'no-cover', { 'is-featured': featured }]}
  style={`--type-main:${meta.main};--type-tint:${meta.tint}`}
  data-type={type}
  data-tags={tags.join('|')}
  data-title={title.toLowerCase()}
>
  {
    cover ? (
      <div class="cover">
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          widths={[400, 800, 1200]}
          sizes="(min-width: 1024px) 600px, (min-width: 600px) 50vw, 100vw"
        />
      </div>
    ) : (
      <div class="type-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <path fill="currentColor" d={meta.icon} />
        </svg>
      </div>
    )
  }
  <div class="body">
    <div class="meta">
      <span class="type"><span class="dot" aria-hidden="true"></span>{typeLabel(type, language)}</span>
      {status && <span class="ds-chip xs outlined warning">{status}</span>}
      <time datetime={isoDate(date)}>{formatLocalizedDate(date, language)}</time>
    </div>
    <h2 class="title">{title}</h2>
    <p class="summary">{summary}</p>
    <ul class="tags" aria-label={language === 'zh' ? '标签' : 'Tags'}>
      {tags.map((t) => <li>#{t}</li>)}
    </ul>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-xxl);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition:
      transform 150ms ease,
      box-shadow 150ms ease;
  }
  .card:hover {
    transform: translateY(-3px);
    box-shadow: var(--elevation-8);
    color: inherit;
  }
  @media (prefers-reduced-motion: reduce) {
    .card:hover {
      transform: none;
    }
  }

  .has-cover {
    background: var(--site-surface);
    border: 1px solid var(--site-border);
  }
  .no-cover {
    background: var(--type-tint);
    border: 1px solid transparent;
  }

  .cover {
    aspect-ratio: 16 / 10;
    border-bottom: 1px solid var(--site-border);
    background: var(--site-subtle);
  }
  .cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .type-icon {
    padding: 24px 24px 0;
    color: var(--type-main);
  }
  /* Inline (not block) on purpose: the prototype's line box adds the space under the icon. */
  .type-icon svg {
    width: 48px;
    height: 48px;
  }

  .body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 24px 24px;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .type {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-condensed);
    font-size: 13px;
    line-height: 16px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--type-main);
  }
  time {
    margin-left: auto;
    font-size: 12px;
    line-height: 16px;
    color: var(--site-text-3);
    white-space: nowrap;
  }

  .title {
    margin: auto 0 0;
    padding-top: 8px;
    font-family: var(--font-condensed);
    font-size: 22px;
    line-height: 1.2;
    font-weight: 700;
    text-wrap: balance;
  }
  .no-cover .title {
    font-size: 26px;
  }
  .summary {
    margin: 0;
    font-size: 14px;
    line-height: 20px;
    color: var(--site-text-2);
    text-wrap: pretty;
  }
  .tags {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    font-size: 12px;
    line-height: 16px;
    color: var(--site-text-3);
  }

  @media (min-width: 600px) {
    .type-icon svg {
      width: 56px;
      height: 56px;
    }
    .title {
      padding-top: 12px;
    }
    .is-featured {
      grid-column: span 2;
    }
    .is-featured .cover {
      aspect-ratio: 16 / 8;
    }
    .is-featured .title {
      font-size: 32px;
    }
  }
</style>
