---
import { icons } from '../lib/icons';
import { TYPE_META, entryUrl, type Entry } from '../lib/entries';
import { MESSAGES, typeLabel, type Locale } from '../lib/i18n';

interface Props {
  language: Locale;
  /** The next-older entry. */
  prev?: Entry;
  /** The next-newer entry. */
  next?: Entry;
}

const { language, prev, next } = Astro.props;
const copy = MESSAGES[language];
---

{
  (prev || next) && (
    <nav class="prevnext" aria-label="More entries">
      {prev && (
        <a class="tile prev" href={entryUrl(prev)} style={`background:${TYPE_META[prev.data.type].tint}`}>
          <span class="label">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="currentColor" d={icons.arrowBack} />
            </svg>
            {copy.previous} · {typeLabel(prev.data.type, language)}
          </span>
          <span class="title">{prev.data.title}</span>
        </a>
      )}
      {next && (
        <a class="tile next" href={entryUrl(next)} style={`background:${TYPE_META[next.data.type].tint}`}>
          <span class="label">
            {copy.next} · {typeLabel(next.data.type, language)}
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="currentColor" d={icons.arrowForward} />
            </svg>
          </span>
          <span class="title">{next.data.title}</span>
        </a>
      )}
    </nav>
  )
}

<style>
  .prevnext {
    max-width: 960px;
    margin: 48px auto 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px;
    border-radius: var(--radius-xxl);
    text-decoration: none;
    color: var(--site-text);
    transition: box-shadow 150ms ease;
  }
  .tile:hover {
    box-shadow: var(--elevation-8);
    color: var(--site-text);
  }
  .label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    line-height: 16px;
    font-weight: 600;
    color: var(--site-text-2);
  }
  .title {
    font-family: var(--font-condensed);
    font-size: 22px;
    line-height: 1.25;
    font-weight: 700;
  }
  @media (min-width: 600px) {
    .prevnext {
      margin-top: 56px;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    .tile {
      padding: 24px;
    }
    .title {
      font-size: 24px;
    }
    .next {
      grid-column: 2;
      align-items: flex-end;
      text-align: right;
    }
  }
  @media (min-width: 1024px) {
    .prevnext {
      margin-top: 64px;
    }
    .tile {
      padding: 28px;
    }
  }
</style>
