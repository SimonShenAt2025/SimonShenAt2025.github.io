---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getSortedEntries } from '../../lib/entries';

export const getStaticPaths = (async () => {
  const entries = await getSortedEntries();
  // Sorted newest first: Previous = next-older entry, Next = next-newer entry.
  return entries.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, prev: entries[i + 1], next: entries[i - 1] },
  }));
}) satisfies GetStaticPaths;

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
---

<PostLayout entry={entry} headings={headings} prev={prev} next={next}>
  <Content />
</PostLayout>
