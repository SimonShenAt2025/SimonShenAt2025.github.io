---
import BaseLayout from '../layouts/BaseLayout.astro';
import Intro from '../components/Intro.astro';
import FilterBar from '../components/FilterBar.astro';
import EntryCard from '../components/EntryCard.astro';
import { getSortedEntries } from '../lib/entries';

const entries = await getSortedEntries();
---

<BaseLayout
  title="Simon Shen"
  description="Tools, ideas, apps and guides worth remembering, from Simon Shen, a software developer in Auckland, New Zealand."
>
  <Intro />
  <main class="container home">
    <FilterBar entries={entries} />
    <div class="grid">
      {entries.map((entry, i) => <EntryCard entry={entry} featured={i === 0} />)}
    </div>
    <div class="empty" hidden>
      <p class="empty-title">No entries match</p>
      <p class="empty-text">Try a different search or remove a filter.</p>
      <button type="button" class="btn btn-outlined btn-sm btn-rounded" data-clear>Clear filters</button>
    </div>
  </main>
</BaseLayout>

<style>
  .home {
    padding-top: 24px;
    padding-bottom: 56px;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-auto-flow: dense;
    gap: 16px;
  }
  .empty {
    padding: 64px 0;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .empty-title {
    margin: 0;
    font-size: 18px;
    line-height: 24px;
    font-weight: 500;
  }
  .empty-text {
    margin: 0 0 8px;
    font-size: 14px;
    line-height: 20px;
    color: var(--site-text-2);
  }
  @media (min-width: 600px) {
    .home {
      padding-top: 28px;
      padding-bottom: 72px;
    }
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
  }
  @media (min-width: 1024px) {
    .home {
      padding-top: 32px;
      padding-bottom: 80px;
    }
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>

<script>
  // Client-side filtering over the static card list, synced to ?type=&tag=a,b&q=
  const typeButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-type].ds-togglebtn')];
  const tagButtons = [...document.querySelectorAll<HTMLButtonElement>('.tag-btn')];
  const search = document.querySelector<HTMLInputElement>('.filters input[type="search"]')!;
  const clearInline = document.querySelector<HTMLButtonElement>('.filters [data-clear]')!;
  const count = document.querySelector<HTMLElement>('.filters .count')!;
  const cards = [...document.querySelectorAll<HTMLAnchorElement>('.grid .card')];
  const empty = document.querySelector<HTMLElement>('.empty')!;

  const knownTypes = new Set(typeButtons.map((b) => b.dataset.type!));
  const knownTags = new Set(tagButtons.map((b) => b.dataset.tag!));

  const state = { type: 'All', tags: [] as string[], q: '' };

  function readUrl() {
    const params = new URLSearchParams(location.search);
    const type = params.get('type');
    state.type = type && knownTypes.has(type) ? type : 'All';
    state.tags = (params.get('tag') ?? '').split(',').filter((t) => knownTags.has(t));
    state.q = params.get('q') ?? '';
    search.value = state.q;
  }

  function writeUrl() {
    const params = new URLSearchParams();
    if (state.type !== 'All') params.set('type', state.type);
    if (state.tags.length) params.set('tag', state.tags.join(','));
    if (state.q.trim()) params.set('q', state.q.trim());
    const query = params.toString().replace(/%2C/g, ',');
    history.replaceState(null, '', query ? `?${query}` : location.pathname);
  }

  function render() {
    const q = state.q.trim().toLowerCase();
    let shown = 0;
    for (const card of cards) {
      const tags = card.dataset.tags!.split('|');
      const match =
        (state.type === 'All' || card.dataset.type === state.type) &&
        (!state.tags.length || state.tags.some((t) => tags.includes(t))) &&
        (!q || card.dataset.title!.includes(q));
      card.hidden = !match;
      card.classList.toggle('is-featured', match && shown === 0);
      if (match) shown++;
    }

    for (const b of typeButtons) {
      const on = b.dataset.type === state.type;
      b.classList.toggle('selected', on);
      b.setAttribute('aria-pressed', String(on));
    }
    for (const b of tagButtons) {
      const on = state.tags.includes(b.dataset.tag!);
      b.setAttribute('aria-pressed', String(on));
      b.firstElementChild!.classList.toggle('secondary', on);
    }

    clearInline.hidden = !(state.type !== 'All' || state.tags.length || q);
    count.textContent = shown === 1 ? '1 entry' : `${shown} entries`;
    empty.hidden = shown > 0;
  }

  function update() {
    render();
    writeUrl();
  }

  typeButtons.forEach((b) =>
    b.addEventListener('click', () => {
      state.type = b.dataset.type!;
      update();
    }),
  );
  tagButtons.forEach((b) =>
    b.addEventListener('click', () => {
      const tag = b.dataset.tag!;
      state.tags = state.tags.includes(tag) ? state.tags.filter((t) => t !== tag) : [...state.tags, tag];
      update();
    }),
  );
  search.addEventListener('input', () => {
    state.q = search.value;
    update();
  });
  document.querySelectorAll<HTMLButtonElement>('[data-clear]').forEach((b) =>
    b.addEventListener('click', () => {
      state.type = 'All';
      state.tags = [];
      state.q = '';
      search.value = '';
      update();
    }),
  );

  readUrl();
  render();
</script>
