---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeShelf from '../components/HomeShelf.astro';
import { getSortedEntries } from '../lib/entries';

const entries = await getSortedEntries('en');
---

<BaseLayout
  title="Simon Shen"
  description="Tools, ideas, apps and guides worth remembering, from Simon Shen, a software developer in Auckland, New Zealand."
  language="en"
>
  <HomeShelf entries={entries} language="en" />
</BaseLayout>
